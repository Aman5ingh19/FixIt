# ──────────────────────────────────────────
# FixIt — Environment Variables
# Copy this file to .env and fill in values
# ──────────────────────────────────────────

# ── App ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Neon PostgreSQL (Cloud Database) ──
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Optional direct unpooled URL for migrations if using connection pooler:
# DIRECT_URL="postgresql://neondb_owner:your_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── JWT Authentication ──
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Redis / Upstash (Optional Cache & Socket Store) ──
REDIS_URL=redis://localhost:6379
# For Upstash Redis (Serverless / Cloud):
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ── Cloudinary (File/Photo Uploads) ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── RabbitMQ (Background Jobs - Phase 2) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Kafka (Event Streaming - Phase 2) ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fixit-api
# For Upstash Kafka / Managed Provider in production:
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=your-upstash-username
# KAFKA_SASL_PASSWORD=your-upstash-password
# KAFKA_SASL_MECHANISM=scram-sha-256

# ── n8n (Workflow Automation - Phase 2) ──
N8N_WEBHOOK_URL=http://localhost:5678/webhook
# For n8n Cloud:
# N8N_WEBHOOK_URL=https://your-workspace.app.n8n.cloud/webhook
# N8N_API_KEY=your-n8n-api-key

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@fixit.com

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
